<Window x:Class="LibraryManagement.Views.LoginAppl_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login"
        Height="520"
        Width="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Grid MouseDown="Border_MouseDown"
          Background="Transparent">

        <Border Background="#1E1E1E"
                CornerRadius="18"
                Width="760"
                Height="470"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  Direction="270"
                                  ShadowDepth="4"
                                  Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE -->
                <Border Grid.Column="0"
                        Background="#252526"
                        CornerRadius="18,0,0,18"
                        Padding="30">

                    <Grid>
                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="LIBRARY"
                                       Foreground="#3498DB"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="MANAGEMENT"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>

                            <Rectangle Height="2"
                                       Width="120"
                                       Fill="#3498DB"
                                       Margin="0,25,0,25"/>

                            <TextBlock Text="Login into your account to manage libraries, users, books and rentals."
                                       Foreground="#BFBFBF"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="20"/>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RIGHT SIDE -->
                <Border Grid.Column="1"
                        Background="#252526"
                        CornerRadius="0,18,18,0"
                        Padding="35">

                    <Grid>

                        <!-- WINDOW BUTTONS -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">

                            <Button x:Name="btnMinimize"
                                    Width="35"
                                    Height="35"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="btnMinimize_Click"
                                    Cursor="Hand">

                                <Rectangle Width="12"
                                           Height="2"
                                           Fill="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Button>

                            
                            <Button x:Name="btnClose"
                                    Content="✕"
                                    Width="35"
                                    Height="35"
                                    Background="Transparent"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="btnClose_Click"
                                    VerticalContentAlignment="Center"
                                    FontSize="16"
                                    Cursor="Hand"/>
                        </StackPanel>

                        <!-- LOGIN FORM -->
                        <StackPanel Width="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,18,0,0">

                            <TextBlock Text="Login"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="#3498DB"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Enter your username and password"
                                       Foreground="#BFBFBF"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,28"/>

                            <TextBlock Text="Username"
                                       Foreground="White"
                                       Margin="0,0,0,6"/>

                            <TextBox x:Name="usernameBox"
                                     Height="40"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Background="#333337"
                                     Foreground="White"
                                     BorderBrush="#3F3F46"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Password"
                                       Foreground="White"
                                       Margin="0,0,0,6"/>

                            <!-- PASSWORD FIELD + SHOW PASSWORD FIELD -->
                            <Grid Margin="0,0,0,8">

                                <PasswordBox x:Name="passBox"
                                             Height="40"
                                             PasswordChanged="passBox_PasswordChanged"
                                             Background="#333337"
                                             Foreground="White"
                                             BorderBrush="#3F3F46"
                                             VerticalContentAlignment="Center"
                                             Padding="12,0"
                                             Visibility="Visible"/>

                                <TextBox x:Name="visiblePassBox"
                                         Height="40"
                                         TextChanged="visiblePassBox_TextChanged"
                                         Background="#333337"
                                         Foreground="White"
                                         BorderBrush="#3F3F46"
                                         VerticalContentAlignment="Center"
                                         Padding="12,0"
                                         Visibility="Collapsed"/>

                            </Grid>

                            <CheckBox x:Name="showPasswordCheckBox"
                                      Content="Show Password"
                                      Foreground="#BFBFBF"
                                      FontSize="12"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,0"
                                      Checked="showPasswordCheckBox_Checked"
                                      Unchecked="showPasswordCheckBox_Unchecked"/>

                            <Grid MinHeight="28"
      Margin="0,8,0,16">

                                <TextBlock Text="{Binding Show_ErrorMessage, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF5C5C"
                                   TextWrapping="Wrap"
                                   MaxWidth="340"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="RESET PASSWORD WITH CODE"
                                        Background="#3E3E42"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Height="45"
                                        HorizontalAlignment="Stretch"
                                        Cursor="Hand"
                                        Click="ResetPasswordWithCode_Click">

                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Grid.Column="2"
                                        Content="LOGIN"
                                        Background="#007ACC"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Height="45"
                                        Width="120"
                                        HorizontalAlignment="Right"
                                        Cursor="Hand"
                                        Command="{Binding Login_command}">

                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>