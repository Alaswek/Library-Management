<Window x:Class="LibraryManagement.Views.ResetPassword_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Grid x:Name="MainGrid"
          Background="#1E1E1E">

        <Border Background="#252526"
                CornerRadius="5"
                Padding="20"
                Margin="15">

            <StackPanel>
                <TextBlock Text="RESET PASSWORD"
                           Foreground="#3498DB"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Username"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="usernameTextBox"
                         Height="30"
                         MaxLength="100"
                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Reset Code"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="resetCodeTextBox"
                         Height="30"
                         MaxLength="20"
                         Text="{Binding ResetCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,0,15"/>

                <TextBlock Text="New Password"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="newPasswordBox"
                             Height="30"
                             MaxLength="255"
                             PasswordChanged="newPasswordBox_PasswordChanged"
                             Background="#333337"
                             Foreground="White"
                             BorderBrush="#3F3F46"
                             VerticalContentAlignment="Center"
                             Padding="5,0"
                             Margin="0,0,0,15"/>

                <TextBlock Text="Confirm New Password"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="confirmPasswordBox"
                             Height="30"
                             MaxLength="255"
                             PasswordChanged="confirmPasswordBox_PasswordChanged"
                             Background="#333337"
                             Foreground="White"
                             BorderBrush="#3F3F46"
                             VerticalContentAlignment="Center"
                             Padding="5,0"
                             Margin="0,0,0,20"/>

                <Button Content="RESET PASSWORD"
                        Height="40"
                        IsDefault="True"
                        Background="#2D7D46"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="ResetPassword_Click"
                        Margin="0,0,0,10"/>

                <Button Content="RESET ADMIN"
                        Height="35"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="ResetAdmin_Click"
                        Margin="0,0,0,10"/>

                <Button Content="CANCEL"
                        Height="35"
                        IsCancel="True"
                        Background="#3E3E42"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Cancel_Click"
                        Margin="0,0,0,15"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>