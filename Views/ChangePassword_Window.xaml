<Window x:Class="LibraryManagement.Views.ChangePassword_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Border Background="#252526"
            CornerRadius="5"
            Padding="20"
            Margin="15">

        <StackPanel>
            <TextBlock Text="CHANGE MY PASSWORD"
                       Foreground="#3498DB"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Current Password"
                       Foreground="White"
                       Margin="0,0,0,5"/>

            <PasswordBox x:Name="currentPasswordBox"
                         Height="30"
                         MaxLength="255"
                         PasswordChanged="currentPasswordBox_PasswordChanged"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,0,15"/>

            <TextBlock Text="New Password"
                       Foreground="White"
                       Margin="0,0,0,5"/>

            <PasswordBox x:Name="newPasswordBox"
                         Height="30"
                         MaxLength="255"
                         PasswordChanged="newPasswordBox_PasswordChanged"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,0,15"/>

            <TextBlock Text="Confirm New Password"
                       Foreground="White"
                       Margin="0,0,0,5"/>

            <PasswordBox x:Name="confirmPasswordBox"
                         Height="30"
                         MaxLength="255"
                         PasswordChanged="confirmPasswordBox_PasswordChanged"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,0,20"/>

            <Button Content="CHANGE PASSWORD"
                    Height="40"
                    IsDefault="True"
                    Background="#2D7D46"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="ChangePassword_Click"
                    Margin="0,0,0,10"/>

            <Button Content="CANCEL"
                    Height="35"
                    IsCancel="True"
                    Background="#3E3E42"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="Cancel_Click"
                    Margin="0,0,0,15"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="White"
                       FontWeight="Bold"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>