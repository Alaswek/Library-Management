<UserControl x:Class="LibraryManagement.UserControllers.Admin_UserControllers.AminRecoveryPassword_UserController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibraryManagement.UserControllers.Admin_UserControllers"
             mc:Ignorable="d" 
             Background="Transparent">

    <Grid Background="#1E1E1E">
        <Border Background="#252526"
                CornerRadius="8"
                Padding="25"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="ADMIN PASSWORD RECOVERY"
                           Foreground="#3498DB"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Username"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <TextBox Height="35"
                         MaxLength="100"
                         Text="{Binding AdminRecoveryUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Recovery Key"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <TextBox Height="35"
                         MaxLength="100"
                         Text="{Binding AdminRecoveryKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="0,0,0,20"/>

                <TextBlock Text="Enter the administrator username and the application recovery key."
                           Foreground="#BFBFBF"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="0,0,0,15"/>

                <Button Content="CONTINUE"
                        Height="40"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding AdminRecoveryCommand}"/>

                <TextBlock Text="{Binding AdminRecoveryStatusMessage}"
                           Foreground="White"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
