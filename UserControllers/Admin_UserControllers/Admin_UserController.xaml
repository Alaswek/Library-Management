<UserControl x:Class="LibraryManagement.UserControllers.Admin_UserControllers.Admin_UserController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             Background="#1E1E1E">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#252526"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,15,0">

            <StackPanel>
                <TextBlock Text="LIBRARY MANAGEMENT"
                           Foreground="#3498DB"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding FormTitle, Mode=OneWay}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Library Name"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <TextBox Height="30"
                         Text="{Binding LibraryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Address"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <TextBox Height="30"
                         Text="{Binding LibraryAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,0,15"/>

                <CheckBox Content="Library is open"
                          IsChecked="{Binding IsOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="White"
                          Margin="0,0,0,25"/>

                <Button Content="SAVE"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="#2D7D46"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding SaveLibraryCommand}"/>

                <Button Content="LOAD SELECTED"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="#3E3E42"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding EditSelectedLibraryCommand}"/>

                <Button Content="DELETE SELECTED"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="#C42B1C"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding DeleteSelectedLibraryCommand}"/>

                <Button Content="CLEAR FORM"
                        Height="35"
                        Margin="0,0,0,10"
                        Background="#555555"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding ClearFormCommand}"/>

                <Button Content="MANAGE USERS"
                        Height="40"
                        Margin="0,15,0,0"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="OpenUserManagement_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#252526"
                    Padding="10"
                    CornerRadius="5"
                    Margin="0,0,0,15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#333337"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Total Libraries"
                                       Foreground="#BFBFBF"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding TotalLibraries, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#333337"
                            CornerRadius="5"
                            Padding="15"
                            Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Open Libraries"
                                       Foreground="#BFBFBF"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding OpenLibraries, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      x:Name="LibrariesTable"
                      ItemsSource="{Binding Libraries}"
                      SelectedItem="{Binding SelectedLibrary, Mode=TwoWay}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="#252526"
                      Foreground="Black"
                      RowBackground="#2D2D2D"
                      AlternatingRowBackground="#333337"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      BorderThickness="1"
                      BorderBrush="#3F3F46"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Margin="0,0,0,15">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3E3E42"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Address"
                                        Binding="{Binding Address}"
                                        Width="2*"/>

                    <DataGridCheckBoxColumn Header="Open"
                                            Binding="{Binding IsOpen}"
                                            Width="80"/>

                    <DataGridTextColumn Header="Seats"
                                        Binding="{Binding AvailableSeats}"
                                        Width="90"/>

                    <DataGridTemplateColumn Header="Actions"
                                            Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit"
                                            Width="65"
                                            Margin="0,0,5,0"
                                            Background="#3E3E42"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.EditSelectedLibraryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Content="Delete"
                                            Width="75"
                                            Background="#C42B1C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DeleteSelectedLibraryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    Background="#252526"
                    Padding="10"
                    CornerRadius="5">

                <TextBlock Text="{Binding LibraryStatusMessage, Mode=OneWay}"
                           Foreground="White"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>