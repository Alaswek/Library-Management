<UserControl x:Class="LibraryManagement.UserControllers.Admin_UserControllers.Administrator_UserManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             Background="#1E1E1E">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#252526"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,15,0">

            <StackPanel>
                <TextBlock Text="ACCOUNT MANAGEMENT"
                           Foreground="#3498DB"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding AccountFormTitle, Mode=OneWay}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,15"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Username"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <TextBox Height="30"
                         Text="{Binding AccountUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#333337"
                         Foreground="White"
                         BorderBrush="#3F3F46"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Password"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="passwordBox"
                             Height="30"
                             PasswordChanged="passwordBox_PasswordChanged"
                             Background="#333337"
                             Foreground="White"
                             BorderBrush="#3F3F46"
                             VerticalContentAlignment="Center"
                             Padding="5,0"
                             Margin="0,0,0,15"/>

                <TextBlock Text="Role"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <ComboBox Height="30"
                          ItemsSource="{Binding AvailableRoles}"
                          SelectedItem="{Binding SelectedRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Background="#333337"
                          Foreground="Black"
                          BorderBrush="#3F3F46"
                          VerticalContentAlignment="Center"
                          Padding="5,0"
                          Margin="0,0,0,15"/>

                <TextBlock Text="Library"
                           Foreground="White"
                           Margin="0,0,0,5"/>

                <ComboBox Height="30"
                          ItemsSource="{Binding Libraries}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedAccountLibraryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsLibrarySelectionRequired, Mode=OneWay}"
                          Background="#333337"
                          Foreground="Black"
                          BorderBrush="#3F3F46"
                          VerticalContentAlignment="Center"
                          Padding="5,0"
                          Margin="0,0,0,15"/>

                <CheckBox Content="Active account"
                          IsChecked="{Binding IsAccountActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="White"
                          Margin="0,0,0,20"/>

                <Button Content="SAVE"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="#2D7D46"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding SaveAccountCommand}"/>

                <Button Content="LOAD SELECTED"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="#3E3E42"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding EditSelectedAccountCommand}"
                        CommandParameter="{Binding SelectedAccount}"/>

                <Button Content="DELETE SELECTED"
                        Height="40"
                        Margin="0,0,0,10"
                        Background="#C42B1C"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding DeleteSelectedAccountCommand}"
                        CommandParameter="{Binding SelectedAccount}"/>

                <Button Content="CLEAR FORM"
                        Height="35"
                        Margin="0,0,0,10"
                        Background="#555555"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding ClearAccountFormCommand}"/>

                <Button Content="REFRESH"
                        Height="35"
                        Margin="0,0,0,10"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Command="{Binding RefreshAccountsCommand}"/>

                <Button Content="BACK TO LIBRARIES"
                        Height="40"
                        Margin="0,15,0,0"
                        Background="#3E3E42"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BackToLibraries_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#252526"
                    Padding="10"
                    CornerRadius="5"
                    Margin="0,0,0,15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Role:"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="1"
                              Height="30"
                              ItemsSource="{Binding FilterRoles}"
                              SelectedItem="{Binding SelectedFilterRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Background="#333337"
                              Foreground="Black"
                              BorderBrush="#3F3F46"
                              VerticalContentAlignment="Center"
                              Padding="5,0"/>

                    <Button Grid.Column="3"
                            Content="Refresh"
                            Width="90"
                            Height="30"
                            Background="#007ACC"
                            Foreground="White"
                            Cursor="Hand"
                            Command="{Binding RefreshAccountsCommand}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="#252526"
                    Padding="10"
                    CornerRadius="5"
                    Margin="0,0,0,15">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="White" Margin="0,0,25,0">
                        <Run Text="Total: "/>
                        <Run Text="{Binding TotalAccounts, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Foreground="White" Margin="0,0,25,0">
                        <Run Text="Active: "/>
                        <Run Text="{Binding ActiveAccounts, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Foreground="White" Margin="0,0,25,0">
                        <Run Text="Admins: "/>
                        <Run Text="{Binding AdministratorAccounts, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Foreground="White">
                        <Run Text="Librarians: "/>
                        <Run Text="{Binding LibrarianAccounts, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="2"
                      x:Name="UsersTable"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="#252526"
                      Foreground="Black"
                      RowBackground="#2D2D2D"
                      AlternatingRowBackground="#333337"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      BorderThickness="1"
                      BorderBrush="#3F3F46"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Margin="0,0,0,15">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3E3E42"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding Id}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Username"
                                        Binding="{Binding Username}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Password"
                                        Binding="{Binding Password}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Role"
                                        Binding="{Binding Role}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Library"
                                        Binding="{Binding Library.Name}"
                                        Width="160"/>

                    <DataGridCheckBoxColumn Header="Active"
                                            Binding="{Binding IsActive}"
                                            Width="80"/>

                    <DataGridTemplateColumn Header="Actions"
                                            Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit"
                                            Width="65"
                                            Margin="0,0,5,0"
                                            Background="#3E3E42"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.EditSelectedAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Content="Delete"
                                            Width="75"
                                            Background="#C42B1C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="8,2"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DeleteSelectedAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3"
                    Background="#252526"
                    Padding="10"
                    CornerRadius="5">

                <TextBlock Text="{Binding AccountStatusMessage, Mode=OneWay}"
                           Foreground="White"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>