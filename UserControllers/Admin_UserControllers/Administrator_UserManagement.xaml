<UserControl x:Class="LibraryManagement.UserControllers.Admin_UserControllers.Administrator_UserManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000" Background="#1E1E1E">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Coloana Stânga: Formular (fixat la 300 pixeli) -->
            <ColumnDefinition Width="300"/>
            <!-- Coloana Dreaptă: Căutare și Tabel (ocupă restul spațiului) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SECȚIUNEA STÂNGA: FORMULAR ADD/MODIFY -->
        <Border Grid.Column="0" Background="#252526" CornerRadius="5" Padding="15" Margin="0,0,15,0">
            <StackPanel>
                <TextBlock Text="USER MANAGEMENT" Foreground="#3498DB" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="Full name" Foreground="White" Margin="0,0,0,5"/>
                <TextBox Height="30" Margin="0,0,0,15" Background="#333337" Foreground="White" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Username" Foreground="White" Margin="0,0,0,5"/>
                <TextBox Height="30" Margin="0,0,0,15" Background="#333337" Foreground="White" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Password" Foreground="White" Margin="0,0,0,5"/>
                <TextBox Height="30" Margin="0,0,0,15" Background="#333337" Foreground="White" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Role" Foreground="White" Margin="0,0,0,5"/>
                <ComboBox Height="30" Margin="0,0,0,25" Background="#333337" Foreground="White" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Library" Foreground="White" Margin="0,0,0,5"/>
                <!-- Înlocuit TextBox cu ComboBox conform cerinței -->
                <ComboBox Height="30" Margin="0,0,0,15" Background="#333337" Foreground="White" BorderBrush="#3F3F46" VerticalContentAlignment="Center" Padding="5,0"
                          ItemsSource="{Binding Libraries}" DisplayMemberPath="Name"/>

                <!-- Butoanele mari din stânga -->
                <Button Content="ADD" Height="40" Margin="0,0,0,10" Background="#2D7D46" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <Button Content="MODIFY" Height="40" Background="#3E3E42" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- SECȚIUNEA DREAPTĂ: CĂUTARE ȘI TABEL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bara de Căutare -->
            <Border Grid.Row="0" Background="#252526" Padding="10" CornerRadius="5" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBox Width="200" Height="30" VerticalContentAlignment="Center" Padding="10,0" 
                                 Background="#333337" Foreground="White" BorderBrush="#3F3F46" 
                                 Tag="Search users..."/>
                        <Button Content="Search" Width="70" Height="30" Margin="5,0,15,0" Background="#007ACC" Foreground="White" Cursor="Hand"/>

                        <TextBlock Text="Role:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="100" Height="30" Background="#333337">
                            <ComboBoxItem Content="Admin" IsSelected="True"/>
                            <ComboBoxItem Content="Librarian"/>
                            <ComboBoxItem Content="Member"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="2" Content="X" Width="30" Height="30" Background="#C42B1C" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="Afisez eroare" Foreground="white" HorizontalAlignment="Left" FontWeight="Bold" VerticalAlignment="Top" Margin="310,479,0,0" Width="72"/>
            <!-- Tabelul (DataGrid) -->
            <DataGrid Grid.Row="1" x:Name="UsersTable" 
                      Background="#252526" Foreground="Black" 
                      RowBackground="#2D2D2D" AlternatingRowBackground="#333337"
                      AutoGenerateColumns="False" CanUserAddRows="False" 
                      BorderThickness="1" BorderBrush="#3F3F46"
                      HeadersVisibility="Column" GridLinesVisibility="None" Margin="0,0,0,40" SelectionChanged="UsersTable_SelectionChanged">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3E3E42"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Full name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Attribute}" Width="*"/>
                    <DataGridTextColumn Header="Password" Binding="{Binding Role}" Width="100"/>
                    <DataGridTextColumn Header="Library" Binding="{Binding Library}" Width="100"/>

                    <DataGridTemplateColumn Header="Acțiuni" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Background="#C42B1C" Foreground="White" 
                                        BorderThickness="0" Padding="8,2" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>